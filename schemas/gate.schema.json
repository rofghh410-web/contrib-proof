{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rofghh410-web/contrib-proof/schemas/gate.schema.json",
  "title": "ContribProof merge gate result",
  "type": "object",
  "required": ["schemaVersion", "kind", "status", "passed", "policy", "summary", "violations"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "gate-result" },
    "status": { "enum": ["pass", "fail"] },
    "passed": { "type": "boolean" },
    "policy": {
      "type": "object",
      "required": ["maxRisk", "failOnFindings", "failOnCheckFailures", "failOnWarnings", "requireReview"],
      "properties": {
        "maxRisk": { "enum": ["routine", "elevated", "high"] },
        "failOnFindings": { "type": "array", "items": { "enum": ["high", "medium", "low"] } },
        "failOnCheckFailures": { "type": "boolean" },
        "failOnWarnings": { "type": "boolean" },
        "requireReview": { "type": "boolean" }
      }
    },
    "summary": {
      "type": "object",
      "required": ["violations", "checkFailures", "warnings", "reviewFindings", "reviewAvailable"],
      "properties": {
        "violations": { "type": "integer", "minimum": 0 },
        "checkFailures": { "type": "integer", "minimum": 0 },
        "warnings": { "type": "integer", "minimum": 0 },
        "reviewFindings": { "type": "integer", "minimum": 0 },
        "reviewAvailable": { "type": "boolean" },
        "risk": { "type": ["string", "null"] }
      }
    },
    "violations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "level", "category", "title", "message", "remediation", "evidence"],
        "properties": {
          "id": { "type": "string" },
          "level": { "enum": ["error", "warning"] },
          "category": { "type": "string" },
          "title": { "type": "string" },
          "message": { "type": "string" },
          "remediation": { "type": "string" },
          "evidence": { "type": "array" }
        }
      }
    }
  }
}
