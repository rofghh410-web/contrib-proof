{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rofghh410-web/contrib-proof/schemas/plan.schema.json",
  "title": "ContribProof remediation plan",
  "type": "object",
  "required": ["schemaVersion", "summary", "items"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "summary": { "type": "object" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "priority", "effort", "owner", "status", "category", "title", "why", "nextStep", "evidence"],
        "properties": {
          "id": { "type": "string" },
          "priority": { "enum": ["P0", "P1", "P2", "P3"] },
          "status": { "enum": ["pass", "warn", "fail", "skip"] },
          "evidence": { "type": "array" }
        }
      }
    }
  }
}
