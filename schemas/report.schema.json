{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rofghh410-web/contrib-proof/schemas/report.schema.json",
  "title": "ContribProof report",
  "type": "object",
  "required": ["schemaVersion", "tool", "mode", "summary", "checks"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "tool": { "type": "object", "required": ["name", "version"] },
    "mode": { "type": "string" },
    "summary": { "type": "object", "required": ["status", "score", "pass", "warn", "fail", "skip", "total"] },
    "checks": { "type": "array", "items": { "$ref": "#/$defs/check" } },
    "plan": { "$ref": "plan.schema.json" },
    "review": { "$ref": "review.schema.json" },
    "gate": { "$ref": "gate.schema.json" }
  },
  "$defs": {
    "check": {
      "type": "object",
      "required": ["id", "category", "status", "title", "message", "evidence"],
      "properties": {
        "id": { "type": "string" },
        "category": { "type": "string" },
        "status": { "enum": ["pass", "warn", "fail", "skip"] },
        "evidence": { "type": "array" }
      }
    }
  }
}
