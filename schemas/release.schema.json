{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rofghh410-web/contrib-proof/schemas/release.schema.json",
  "title": "ContribProof release readiness",
  "type": "object",
  "required": ["schemaVersion", "kind", "available", "summary", "checks", "recommendations"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "release-readiness" },
    "available": { "type": "boolean" },
    "root": { "type": "string" },
    "since": { "type": ["string", "null"] },
    "version": { "type": ["string", "null"] },
    "reason": { "type": "string" },
    "commits": { "type": "array" },
    "changes": { "type": "object" },
    "summary": {
      "type": "object",
      "required": ["status", "score", "pass", "warn", "fail", "total"],
      "properties": {
        "status": { "enum": ["pass", "needs-attention", "unavailable"] },
        "score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "pass": { "type": "integer", "minimum": 0 },
        "warn": { "type": "integer", "minimum": 0 },
        "fail": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status", "severity", "title", "message", "evidence"],
        "properties": {
          "id": { "type": "string" },
          "status": { "enum": ["pass", "warn", "fail"] },
          "severity": { "enum": ["info", "warning", "error"] },
          "title": { "type": "string" },
          "message": { "type": "string" },
          "remediation": { "type": ["string", "null"] },
          "evidence": { "type": "array" }
        }
      }
    },
    "recommendations": { "type": "array", "items": { "type": "string" } }
  }
}
