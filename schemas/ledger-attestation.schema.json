{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rofghh410-web/contrib-proof/schemas/ledger-attestation.schema.json",
  "title": "ContribProof maintenance ledger attestation",
  "type": "object",
  "required": ["schemaVersion", "kind", "algorithm", "createdAt", "subject", "key", "signature"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "ledger-attestation" },
    "algorithm": { "const": "ed25519" },
    "createdAt": { "type": "string", "format": "date-time" },
    "subject": {
      "type": "object",
      "required": ["entries", "headHash", "ledgerHash"],
      "properties": {
        "entries": { "type": "integer", "minimum": 0 },
        "headHash": { "type": ["string", "null"] },
        "ledgerHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "key": {
      "type": "object",
      "required": ["keyId", "publicKeySha256"],
      "properties": {
        "keyId": { "type": "string", "minLength": 1 },
        "publicKeySha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "signature": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
