{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rofghh410-web/contrib-proof/schemas/context.schema.json",
  "title": "ContribProof execution context",
  "type": "object",
  "required": ["schemaVersion", "runtime", "git", "configuration", "options"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runtime": {
      "type": "object",
      "required": ["node", "platform", "arch", "cwd"],
      "properties": { "node": { "type": "string" }, "platform": { "type": "string" }, "arch": { "type": "string" }, "cwd": { "type": "string" } }
    },
    "git": {
      "type": "object",
      "required": ["exactRoot", "root", "commit", "branch", "dirty", "shallow"],
      "properties": {
        "exactRoot": { "type": ["boolean", "null"] },
        "root": { "type": ["string", "null"] },
        "commit": { "type": ["string", "null"] },
        "branch": { "type": ["string", "null"] },
        "dirty": { "type": ["boolean", "null"] },
        "shallow": { "type": ["boolean", "null"] }
      }
    },
    "configuration": {
      "type": "object",
      "required": ["path", "sha256", "usedDefaults", "errors"],
      "properties": { "path": { "type": ["string", "null"] }, "sha256": { "type": ["string", "null"] }, "usedDefaults": { "type": "boolean" }, "errors": { "type": "array" } }
    },
    "options": {
      "type": "object",
      "required": ["includeDiff", "execute", "base", "applyExceptions", "exceptionsPath"],
      "properties": { "includeDiff": { "type": "boolean" }, "execute": { "type": "boolean" }, "base": { "type": ["string", "null"] }, "applyExceptions": { "type": "boolean" }, "exceptionsPath": { "type": ["string", "null"] } }
    }
  }
}
